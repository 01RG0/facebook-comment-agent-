ZERNIO_API_KEY=                    # From zernio.com/dashboard/api-keys
ZERNIO_WEBHOOK_SECRET=             # Random string -- set same value in Zernio webhook config
ZERNIO_PROFILE_ID=                 # From GET https://zernio.com/api/v1/profiles

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# DEPRECATED -- replaced by Zernio:
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# NEXT_PUBLIC_FACEBOOK_APP_ID=

# Queue (Redis)
REDIS_URL=

# App
NEXT_PUBLIC_APP_URL=

# AI providers (system-level fallbacks; users can override per-page via UI)
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# Admin panel — the email address that gets admin access
ADMIN_EMAIL=

# Railway health monitor (optional — leave blank if not using the monitor)
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_WEB_SERVICE_ID=
RAILWAY_WORKER_SERVICE_ID=
RAILWAY_REDIS_SERVICE_ID=
WEB_APP_URL=
